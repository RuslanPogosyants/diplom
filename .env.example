# GigaChat API Configuration (для LLM фич)
# Получите credentials на: https://developers.sber.ru/studio/workspaces

# Вставьте ваш Client Secret (длинная строка символов)
GIGACHAT_CREDENTIALS=вставьте_сюда_ваш_client_secret

# Scope для физических лиц (не меняйте!)
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# System Configuration
DEVICE=auto  # cuda, cpu, auto
MODELS_DIR=models/
ARTIFACTS_DIR=artifacts/

# Logging
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL

# ВАЖНО: Не коммитьте .env в git!
# Этот файл содержит приватные ключи
