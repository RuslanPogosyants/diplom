# GigaChat API Configuration (опционально, для LLM фич)
GIGACHAT_CREDENTIALS=your_api_key_here
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# System Configuration
DEVICE=auto  # cuda, cpu, auto
